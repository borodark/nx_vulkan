# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
nx_vulkan-*.tar

# Temporary files, for example, from tests.
/tmp/

# Rust NIF build artifacts
target/
**/*.rs.bk
native/*/target/

# Native NIF output
priv/native/

# OS
.DS_Store

Cargo.lock
/mix.lock
# priv/shaders is now vendored from Spirit (see c_src/spirit/VENDOR.md);
# previous build.rs copy-step made it transient, but the hex-publish
# vendoring made it canonical content tracked in git.

# Cached SPV blobs compiled by Nx.Vulkan.Synthesis at runtime
/priv/shader_cache/

# dialyzer PLTs (see mix.exs :dialyzer plt_file)
/priv/plts/

# Agent worktrees (Claude Code `isolation: worktree`) — scratch checkouts,
# not repository content.
/.claude/worktrees/

# Build intermediates. `scripts/build_and_test.sh` compiles each glsl/*.comp to
# glsl/*.spv and then COPIES it to priv/shaders/, which is the canonical
# location and the only one lib/nx_vulkan/vulkano_backend.ex resolves. Seventeen
# of these were tracked, mirroring priv/shaders/ partially and validated by
# nothing: regenerating only priv/shaders/ would have left them silently stale.
# Found by the Jetson's shader-reproducibility check on 2026-08-28, which
# compared them on its own initiative.
glsl/*.spv
