#version 450
#extension GL_ARB_gpu_shader_fp64 : require

// Tiled f64 matmul. C = A*B, A is MxK row-major, B is KxN row-major. 16x16
// shared-memory tiling: each workgroup stages 16x16 tiles of A and B through
// workgroup-shared memory so every global load is reused 16x, cutting global
// traffic. Boundary-safe for non-multiple-of-16 shapes. Dispatch matches the
// matmul NIF: global x over N, global y over M, local 16x16. (The f64-ALU rate
// still caps the ceiling on rate-limited GPUs; tiling removes the bandwidth
// component.)

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer A { double a[]; };
layout(std430, binding = 1) readonly buffer B { double b[]; };
layout(std430, binding = 2) writeonly buffer O { double o[]; };

layout(push_constant) uniform Push {
    uint m;
    uint n;
    uint k;
} push;

const uint T = 16u;
shared double As[T][T];
shared double Bs[T][T];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;
    uint lx = gl_LocalInvocationID.x;

    double acc = 0.0lf;
    uint tiles = (push.k + T - 1u) / T;

    for (uint t = 0u; t < tiles; ++t) {
        uint aCol = t * T + lx;
        As[ly][lx] = (row < push.m && aCol < push.k) ? a[row * push.k + aCol] : 0.0lf;

        uint bRow = t * T + ly;
        Bs[ly][lx] = (bRow < push.k && col < push.n) ? b[bRow * push.n + col] : 0.0lf;

        barrier();

        for (uint i = 0u; i < T; ++i) {
            acc += As[ly][i] * Bs[i][lx];
        }

        barrier();
    }

    if (row < push.m && col < push.n) {
        o[row * push.n + col] = acc;
    }
}
