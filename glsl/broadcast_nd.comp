#version 450

// Explicit Nx.broadcast/3 for rank <= 4, TYPE-GENERIC.
//
// Implicit broadcasting inside a binary op already runs on the GPU
// (elementwise_binary_bcast_*.comp does this same index arithmetic), but the
// standalone broadcast callback had no shader at all and always went to the
// host. That mattered more than its own cost: it left the result on
// Nx.BinaryBackend, and a relu gradient's broadcast-of-zero then made select/4
// fall back too.
//
// Semantics match `Nx.broadcast(t, shape, axes: axes)`: input axis i lands on
// output axis axes[i], and any input axis of size 1 repeats along its output
// axis. A rank-0 input (in_rank = 0) fills the output with a[0].
//
// TYPE GENERICITY (W1): was `broadcast_nd_f32` + `broadcast_nd_f64`, identical
// but for the element type. Broadcasting is a pure index remap — every output
// element is a copy of some input element, never a computation — so both
// buffers are read as `uint` and each element is copied as
// `ews = element_bytes / 4` words. See the long note in transpose_nd.comp.
//
// Params buffer: [out_rank, in_rank, ews, out[4], in[4], axes[4]] — shapes
// left-aligned and padded to 4. One thread per output element.
//
// NOTE the params layout differs from its two siblings: this shader needs two
// ranks, so `ews` lands at index 2 rather than 1. It is still the slot right
// after the ranks, which is the family's convention.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer A { uint a[]; };
layout(std430, binding = 1) writeonly buffer O { uint o[]; };
layout(std430, binding = 2) readonly  buffer P { int prm[]; };

layout(push_constant) uniform Push {
    uint n;
} p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= p.n) return;

    uint out_rank = uint(prm[0]);
    uint in_rank  = uint(prm[1]);
    uint ews      = uint(prm[2]);

    uint outs[4];
    uint ins[4];
    uint axes[4];
    for (uint i = 0u; i < 4u; ++i) {
        outs[i] = uint(prm[3 + i]);
        ins[i]  = uint(prm[7 + i]);
        axes[i] = uint(prm[11 + i]);
    }

    // Output coordinates.
    uint coord[4];
    uint idx = gid;
    for (int d = int(out_rank) - 1; d >= 0; --d) {
        coord[d] = idx % outs[d];
        idx = idx / outs[d];
    }

    // Row-major strides of the input, in elements.
    uint istride[4];
    uint s = 1u;
    for (int i = int(in_rank) - 1; i >= 0; --i) {
        istride[i] = s;
        s *= ins[i];
    }

    // Each input axis reads its mapped output coordinate, or 0 where it
    // broadcasts (size 1).
    uint in_off = 0u;
    for (uint i = 0u; i < in_rank; ++i) {
        uint c = coord[axes[i]];
        uint src = (ins[i] == 1u) ? 0u : c;
        in_off += src * istride[i];
    }

    for (uint w = 0u; w < ews; ++w) {
        o[gid * ews + w] = a[in_off * ews + w];
    }
}
