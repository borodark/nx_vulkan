#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

// f64 sibling of leapfrog_chain_studentt.comp. All buffers and
// arithmetic in f64. Output sizes double (8 bytes per element).
//
// Fused chain of K NUTS leapfrog steps for Student-t(nu, mu, sigma).
// Real-valued — no transform needed.
//
// log p(q | nu, mu, sigma) includes constant terms passed as logp_const.
// Per-element: -((nu+1)/2) * log(1 + (1/nu)*((q-mu)/sigma)^2)
// Gradient: -((nu+1)/(nu*sigma^2)) * (q-mu) / (1 + (1/nu)*((q-mu)/sigma)^2)
//
// Push constants: {n, K, eps, mu, sigma, nu, logp_const} = 4 + 4 + 8 + 8 + 8 + 8 + 8 = 48 bytes.
// Single workgroup; n <= 256.

layout (local_size_x = 256) in;

layout (push_constant) uniform Push {
    uint   n;
    uint   K;
    double eps;
    double mu;
    double sigma;
    double nu;
    double logp_const;   // log Gamma((nu+1)/2) - log Gamma(nu/2) - 0.5*log(pi*nu) - log(sigma)
} pc;

layout (std430, binding = 0) readonly  buffer In_q     { double q_init[]; };
layout (std430, binding = 1) readonly  buffer In_p     { double p_init[]; };
layout (std430, binding = 2) readonly  buffer In_mass  { double inv_mass[]; };
layout (std430, binding = 3) writeonly buffer Out_q    { double q_chain[]; };    // K × n
layout (std430, binding = 4) writeonly buffer Out_p    { double p_chain[]; };    // K × n
layout (std430, binding = 5) writeonly buffer Out_grad { double grad_chain[]; }; // K × n
layout (std430, binding = 6) writeonly buffer Out_logp { double logp_chain[]; }; // K

shared double partial[256];

void main() {
    uint i   = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationIndex;

    bool in_bounds = (i < pc.n);
    double inv_sigma2 = 1.0LF / (pc.sigma * pc.sigma);
    double inv_nu = 1.0LF / pc.nu;
    double grad_coeff = -(pc.nu + 1.0LF) * inv_nu * inv_sigma2;
    double logp_exp = -0.5LF * (pc.nu + 1.0LF);

    double qi = in_bounds ? q_init[i] : 0.0LF;
    double pi = in_bounds ? p_init[i] : 0.0LF;
    double mi = in_bounds ? inv_mass[i] : 0.0LF;

    for (uint k = 0; k < pc.K; k++) {
        // Half-step momentum at q
        double diff = qi - pc.mu;
        double z2 = diff * diff * inv_sigma2;
        double denom = 1.0LF + z2 * inv_nu;
        double grad_q = in_bounds ? grad_coeff * diff / denom : 0.0LF;
        double p_half = pi + 0.5LF * pc.eps * grad_q;

        // Full-step position
        qi = qi + pc.eps * mi * p_half;

        // Half-step momentum at q_new
        double diff_n = qi - pc.mu;
        double z2_n = diff_n * diff_n * inv_sigma2;
        double denom_n = 1.0LF + z2_n * inv_nu;
        double grad_qn = in_bounds ? grad_coeff * diff_n / denom_n : 0.0LF;
        pi = p_half + 0.5LF * pc.eps * grad_qn;

        if (in_bounds) {
            q_chain[k * pc.n + i]    = qi;
            p_chain[k * pc.n + i]    = pi;
            grad_chain[k * pc.n + i] = grad_qn;
        }

        // Per-step logp: sum_i logp_exp * log(denom_n) + n * logp_const
        double lp_i = in_bounds ? logp_exp * double(log(float(denom_n))) : 0.0LF;
        partial[tid] = lp_i;
        barrier();

        for (uint s = 128u; s > 0u; s /= 2u) {
            if (tid < s) partial[tid] += partial[tid + s];
            barrier();
        }

        if (tid == 0u) {
            logp_chain[k] = partial[0] + double(pc.n) * pc.logp_const;
        }

        barrier();
    }
}
