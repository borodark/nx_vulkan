#version 450

// s32 elementwise unary op. Spec constant 0 selects the op, sharing the float
// shaders' codes:
//   3=abs 4=neg 7=relu 8=ceil 9=floor 10=sign 12=square
// and adding the integer-only codes:
//   13=bitwise_not 14=population_count 15=count_leading_zeros
//
// The transcendental codes (0=exp 1=log 2=sqrt 5=sigmoid 6=tanh 11=reciprocal)
// are UNREACHABLE here and deliberately absent. Nx runs those through
// `Nx.Type.to_floating/1` before dispatch, so an s32 input produces a FLOAT
// output template and the `a_v.type == type` guard in the backend sends it to
// the float shader instead. Nothing integer ever asks this shader for `exp`.
//
// ceil and floor are the identity on integers. They are listed rather than
// omitted because Nx does dispatch them at integer dtypes, and the identity is
// the right answer — not a gap.

layout(local_size_x = 256) in;
layout(constant_id = 0) const int OP = 0;

layout(std430, binding = 0) readonly buffer A { int a[]; };
layout(std430, binding = 1) writeonly buffer O { int o[]; };

layout(push_constant) uniform Push { uint n; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;

    int x = a[i];
    int r;
    switch (OP) {
        case 3:  r = abs(x); break;
        case 4:  r = -x; break;
        case 7:  r = max(x, 0); break;
        case 8:  r = x; break;
        case 9:  r = x; break;
        case 10: r = sign(x); break;
        case 12: r = x * x; break;
        case 13: r = ~x; break;
        case 14: r = bitCount(x); break;
        // Counted over the UNSIGNED bit pattern, which is the only form that
        // gives BinaryBackend's answers. findMSB on a *signed* int reports the
        // most significant 0 bit for negatives and -1 for both 0 and -1, so it
        // cannot express this; findMSB on a uint reports the most significant 1
        // bit and -1 only for zero. That makes 31 - findMSB exact at all three
        // boundaries: 0 -> 32, 1 -> 31, -1 -> 0.
        case 15: r = 31 - findMSB(uint(x)); break;
        default: r = 0;
    }
    o[i] = r;
}
