#version 450
#extension GL_ARB_gpu_shader_fp64 : require

// all / any over an axis — f64 input, PACKED u8 output. Collapses the
// middle `reduce_size` axis of an (outer, reduce_size, inner) view, and shares
// reduce_axis_*.comp's bindings and push layout, so it reuses `reduce_axis/7`
// with no new NIF.
//
// push `op`: 0 = all (every element truthy), 1 = any (at least one).
//
// TWO THINGS DIFFER from the reduce shaders it borrows from.
//
// The OUTPUT IS u8, not the input type. Nx types `all`/`any` as {:u, 8}
// whatever went in, so this writes packed u32 words — 4 results per word, the
// same trick compare_*.comp uses — and ONE THREAD COVERS FOUR OUTPUT SLOTS
// rather than one. The caller pads the output buffer to a 4-byte multiple.
//
// That makes the dispatch geometry deliberately loose: `reduce_axis/7` launches
// ceil(outer*inner / 256) threads, which is 4x more than the ceil(nwords / 256)
// this needs. The surplus threads return at the bounds guard. Reusing the NIF
// is worth the idle threads; a dedicated one would exist only to divide by
// four.
//
// Truthiness is `!= 0`, which is what Nx means by it. Note that NaN is
// therefore TRUTHY — `NaN != 0.0` is true in IEEE and BinaryBackend agrees, so
// this needs no special case, unlike argreduce_*.comp where NaN had to be
// handled explicitly.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer A { double a[]; };
layout(std430, binding = 1) writeonly buffer O { uint o[]; };

layout(push_constant) uniform Push {
    uint outer;
    uint reduce_size;
    uint inner;
    uint op;
} p;

bool truthy(uint i) {
    return a[i] != 0.0lf;
}

void main() {
    uint word = gl_GlobalInvocationID.x;
    uint slots = p.outer * p.inner;
    uint nwords = (slots + 3u) / 4u;
    if (word >= nwords) return;

    bool is_any = (p.op == 1u);

    uint packed = 0u;
    for (uint j = 0u; j < 4u; ++j) {
        uint gid = word * 4u + j;
        if (gid >= slots) break;

        uint outr = gid / p.inner;
        uint inr = gid % p.inner;
        uint base = outr * p.reduce_size * p.inner + inr;

        // `all` starts true and is cleared by a falsy element; `any` starts
        // false and is set by a truthy one. An empty reduce keeps the seed,
        // which is the standard identity for both.
        bool acc = !is_any;
        for (uint r = 0u; r < p.reduce_size; ++r) {
            bool v = truthy(base + r * p.inner);
            acc = is_any ? (acc || v) : (acc && v);
        }

        packed |= (acc ? 1u : 0u) << (j * 8u);
    }

    o[word] = packed;
}
