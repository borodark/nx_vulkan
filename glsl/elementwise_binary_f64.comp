#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

layout (local_size_x = 256) in;

// Specialization constant selects operation at pipeline creation.
// Switch eliminated by SPIR-V compiler — zero runtime cost.
layout (constant_id = 0) const int OP = 0;

// Push constant: number of elements
layout (push_constant) uniform Push {
    uint n;
} pc;

layout (std430, binding = 0) readonly buffer InputA { float64_t a[]; };
layout (std430, binding = 1) readonly buffer InputB { float64_t b[]; };
layout (std430, binding = 2) writeonly buffer Output { float64_t c[]; };

// GLSL builtins (exp, log, pow, tanh) lack f64 overloads.
// Cast through float for transcendentals — precision limited to f32
// for these ops, but arithmetic (+, -, *, /, sqrt, abs, min, max,
// comparisons) stays in full f64.
float64_t pow_f64(float64_t x, float64_t y) {
    return float64_t(pow(float(x), float(y)));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;

    float64_t x = a[i];
    float64_t y = b[i];
    float64_t r;

    switch (OP) {
        case 0: r = x + y; break;                      // add
        case 1: r = x * y; break;                      // multiply
        case 2: r = x - y; break;                      // subtract
        case 3: r = x / y; break;                      // divide
        case 4: r = pow_f64(x, y); break;              // power
        case 5: r = max(x, y); break;                  // max
        case 6: r = min(x, y); break;                  // min
        // Codes 7-9 USED TO BE equal/less/greater here, left over from before
        // compare_f64.comp existed. They were unreachable —
        // `binary_spv({:f, 64}, code)` caps at 6 — but they were worse than
        // dead: they gave code 8 a different MEANING in this file than in
        // @binary_ops, where 8 is `remainder`. Widening that guard by one would
        // have returned a comparison mask and looked entirely plausible.
        // Removed rather than commented around.
        // remainder — the sign of the DIVIDEND, not the divisor.
        //
        // GLSL's `mod(x, y)` is `x - y * floor(x / y)`, which follows the
        // DIVISOR: mod(-5, 3) is 1. Nx.BinaryBackend truncates toward zero, so
        // remainder(-5, 3) is -2 and remainder(5, -3) is 2 — the C `fmod` rule,
        // and the same rule trunc_div/2 implements for the integer shader.
        // Using `mod` here would be wrong on exactly half the sign pairs.
        case 8: r = x - y * trunc(x / y); break;       // remainder
        default: r = 0.0LF; break;
    }

    c[i] = r;
}
