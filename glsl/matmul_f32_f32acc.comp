#version 450

// f32 matmul with a pure f32 accumulator — the fast variant of the f32 matmul
// accumulator policy (see F32_PLAN.md). Selected when
// :f32_matmul_accumulator is set to :f32; the default :f64 uses
// matmul_f32_f64acc. On f64-rate-limited GPUs (Kepler/consumer Ampere) this is
// 1.4-1.7x faster than f64, at the cost of precision that degrades as K grows
// (catastrophic cancellation on ill-conditioned dot products).

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };

layout(push_constant) uniform Push {
    uint m;
    uint n;
    uint k;
} push;

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    if (row >= push.m || col >= push.n) return;

    float acc = 0.0;
    for (uint i = 0u; i < push.k; ++i) {
        acc += a[row * push.k + i] * b[i * push.n + col];
    }
    o[row * push.n + col] = acc;
}
