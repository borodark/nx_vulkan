#version 450
#extension GL_ARB_gpu_shader_fp64 : require
// Narrow f64 -> f32 on the GPU (mixed precision). n = element count.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer In { double inp[]; };
layout(std430, binding = 1) writeonly buffer Out { float outp[]; };
layout(push_constant) uniform Push { uint n; } p;
void main() { uint i = gl_GlobalInvocationID.x; if (i >= p.n) return; outp[i] = float(inp[i]); }
