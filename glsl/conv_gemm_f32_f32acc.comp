#version 450

// Tiled f32 conv GEMM with a pure f32 accumulator — fast variant of the conv
// accumulator policy (:f32). Computes C = A·Wᵀ over (M = N·O_total rows, Cout
// cols): out[n,oc,o] = sum_l im2col(A)[(n·O_total+o)·K + l] · kernel[oc·K + l],
// written straight into canonical {N,Cout,O_total} layout.
//
// 16×16 shared-memory tiling: each workgroup stages a 16×16 tile of A (rows of
// the im2col matrix) and of W (the kernel, Cout×K) through shared memory,
// reusing every global load 16×. Boundary-safe for shapes not a multiple of 16.
// Dispatch: global x over Cout, global y over M, local 16×16 (see conv_gemm NIF).

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer W { float w[]; };
layout(std430, binding = 2) writeonly buffer Out { float outp[]; };

layout(push_constant) uniform Push {
    uint N;
    uint Cout;
    uint O_total;
    uint K;
} p;

const uint T = 16u;
shared float As[T][T];
shared float Ws[T][T];

void main() {
    uint M = p.N * p.O_total;
    uint row = gl_GlobalInvocationID.y;   // im2col row (0..M)
    uint oc = gl_GlobalInvocationID.x;    // output channel (0..Cout)
    uint ly = gl_LocalInvocationID.y;
    uint lx = gl_LocalInvocationID.x;

    float acc = 0.0;
    uint tiles = (p.K + T - 1u) / T;

    for (uint t = 0u; t < tiles; ++t) {
        uint aCol = t * T + lx;
        As[ly][lx] = (row < M && aCol < p.K) ? a[row * p.K + aCol] : 0.0;

        uint wCol = t * T + ly;
        Ws[ly][lx] = (oc < p.Cout && wCol < p.K) ? w[oc * p.K + wCol] : 0.0;

        barrier();

        for (uint i = 0u; i < T; ++i) {
            acc += As[ly][i] * Ws[i][lx];
        }

        barrier();
    }

    if (row < M && oc < p.Cout) {
        uint n = row / p.O_total;
        uint o = row % p.O_total;
        outp[(n * p.Cout + oc) * p.O_total + o] = acc;
    }
}
