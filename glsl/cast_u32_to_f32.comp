#version 450
// Widen u32 -> f32 on the GPU. n = element count.
//
// T12, third piece. Nx types the sum of a {:u, 8} mask as {:u, 32}, and
// Nx.Defn.Grad's reduce_max rule then DIVIDES by that count to split the
// gradient between tied maxima. So the count comes back as a u32 tensor and
// meets an f32 one in `divide`; without this entry coerce_to/2 returned nil
// and the divide host-fell-back — the last hop of softmax's backward pass,
// left stranded after the u8 cast and the u8 reduce had closed the other two.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer In { uint inp[]; };
layout(std430, binding = 1) writeonly buffer Out { float outp[]; };
layout(push_constant) uniform Push { uint n; } p;
void main() { uint i = gl_GlobalInvocationID.x; if (i >= p.n) return; outp[i] = float(inp[i]); }
