#version 450
// Widen s32 -> f32 on the GPU. n = element count.
//
// Nx materialises integer literals and then BROADCASTS them: a relu gradient
// is select(x > 0, g, 0) where the 0 arrives as a full {:s, 32} tensor, not a
// scalar. Without an integer cast path, coerce_to/2 returned nil and select
// host-fell-back — see the fallback census.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer In { int inp[]; };
layout(std430, binding = 1) writeonly buffer Out { float outp[]; };
layout(push_constant) uniform Push { uint n; } p;
void main() { uint i = gl_GlobalInvocationID.x; if (i >= p.n) return; outp[i] = float(inp[i]); }
