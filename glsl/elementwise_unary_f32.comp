#version 450

// f32 elementwise unary op. Spec constant 0 selects the op, matching the f64
// shader's convention (apply_unary passes op_code as spec constant 0):
//   0=exp 1=log 2=sqrt 3=abs 4=neg 5=sigmoid 6=tanh 7=relu
//   8=ceil 9=floor 10=sign 11=reciprocal 12=square

layout(local_size_x = 256) in;
layout(constant_id = 0) const int OP = 0;

layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) writeonly buffer O { float o[]; };

layout(push_constant) uniform Push { uint n; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;

    float x = a[i];
    float r;
    switch (OP) {
        case 0:  r = exp(x); break;
        case 1:  r = log(x); break;
        case 2:  r = sqrt(x); break;
        case 3:  r = abs(x); break;
        case 4:  r = -x; break;
        case 5:  r = 1.0 / (1.0 + exp(-x)); break;
        case 6:  r = tanh(x); break;
        case 7:  r = max(x, 0.0); break;
        case 8:  r = ceil(x); break;
        case 9:  r = floor(x); break;
        case 10: r = sign(x); break;
        case 11: r = 1.0 / x; break;
        case 12: r = x * x; break;
        // round — HALF AWAY FROM ZERO, which is neither of GLSL's built-ins.
        //
        // `round()` is implementation-defined at a .5 tie (it may round to
        // even) and `roundEven()` definitely rounds to even, so round(2.5) and
        // round(-0.5) would disagree with Nx.BinaryBackend, which rounds away
        // from zero: [-2.5, -0.5, 0.5, 2.5] -> [-3, -1, 1, 3]. Spelling it out
        // is the only way to pin it across drivers.
        case 16: r = sign(x) * floor(abs(x) + 0.5); break;   // round
        // 17-28 added 2026-09-01. GLSL.std.450 provides all of these for f32;
        // they were host-falling-back only because no arm existed.
        case 17: r = sin(x); break;
        case 18: r = cos(x); break;
        case 19: r = tan(x); break;
        case 20: r = asin(x); break;
        case 21: r = acos(x); break;
        case 22: r = atan(x); break;
        case 23: r = sinh(x); break;
        case 24: r = cosh(x); break;
        case 25: r = inversesqrt(x); break;                  // rsqrt
        // Complex.cbrt: pow(n, 1/3) for n >= 0, -cbrt(|n|) below. sign(0) is 0
        // and pow(0, 1/3) is 0, so zero falls out correctly.
        case 26: r = sign(x) * pow(abs(x), 1.0 / 3.0); break; // cbrt
        // expm1 and log1p are Nx's OWN formulas, not better ones. nx defines
        // expm1 as Complex.exp(x) - 1 and log1p as Complex.log(x + 1), so a
        // series expansion near zero would be more accurate AND would disagree
        // with Nx.BinaryBackend. Agreement is the bar.
        case 27: r = exp(x) - 1.0; break;                     // expm1
        case 28: r = log(x + 1.0); break;                     // log1p
        default: r = 0.0;
    }
    o[i] = r;
}
