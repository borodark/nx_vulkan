#version 450
#extension GL_ARB_gpu_shader_fp64 : require

// Tiled f32 matmul with an f64 accumulator — the accuracy-safe default of the
// f32 matmul accumulator policy (:f64). f32 storage, but the dot product is
// accumulated in double and rounded to f32 only on store, matching a
// f64-accumulating reference to f32 round-off.
//
// Shared-memory tiling (16x16): each workgroup stages 16x16 tiles of A and B
// through workgroup-shared memory so every global load is reused 16x, cutting
// global-memory traffic. The tiles are stored f32; only the accumulation is
// f64. On f64-rate-limited GPUs the f64 MACs still dominate this variant (that
// is why :f32 exists), but tiling removes the bandwidth component.
//
// C = A*B, A is MxK row-major, B is KxN row-major. Dispatch matches the matmul
// NIF: global x over N, global y over M, local 16x16.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };

layout(push_constant) uniform Push {
    uint m;
    uint n;
    uint k;
} p;

const uint T = 16u;
shared float As[T][T];
shared float Bs[T][T];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;
    uint lx = gl_LocalInvocationID.x;

    double acc = 0.0lf;
    uint tiles = (p.k + T - 1u) / T;

    for (uint t = 0u; t < tiles; ++t) {
        uint aCol = t * T + lx;
        As[ly][lx] = (row < p.m && aCol < p.k) ? a[row * p.k + aCol] : 0.0;

        uint bRow = t * T + ly;
        Bs[ly][lx] = (bRow < p.k && col < p.n) ? b[bRow * p.n + col] : 0.0;

        barrier();

        for (uint i = 0u; i < T; ++i) {
            acc += double(As[ly][i]) * double(Bs[i][lx]);
        }

        barrier();
    }

    if (row < p.m && col < p.n) {
        o[row * p.n + col] = float(acc);
    }
}
