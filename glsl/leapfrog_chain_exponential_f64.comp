#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

// f64 sibling of leapfrog_chain_exponential.comp. All buffers and
// arithmetic in f64. Output sizes double (8 bytes per element).
//
// Fused chain of K NUTS leapfrog steps for an Exponential(lambda)
// log-density model on the unconstrained line (log-transform).
//
// Unconstrained parameterization: q_uc = log(q), where q ~ Exp(lambda).
// Log-density (includes Jacobian): log p(q_uc) = q_uc - lambda * exp(q_uc)
// Gradient: grad = 1.0 - lambda * exp(q_uc)
//
// Push constants: {n, K, eps, lambda} = 4 + 4 + 8 + 8 = 24 bytes.
// Single workgroup version (n <= 256).

layout (local_size_x = 256) in;

layout (push_constant) uniform Push {
    uint   n;
    uint   K;
    double eps;
    double lambda;   // rate parameter
} pc;

layout (std430, binding = 0) readonly  buffer In_q     { double q_init[]; };
layout (std430, binding = 1) readonly  buffer In_p     { double p_init[]; };
layout (std430, binding = 2) readonly  buffer In_mass  { double inv_mass[]; };
layout (std430, binding = 3) writeonly buffer Out_q    { double q_chain[]; };    // K × n
layout (std430, binding = 4) writeonly buffer Out_p    { double p_chain[]; };    // K × n
layout (std430, binding = 5) writeonly buffer Out_grad { double grad_chain[]; }; // K × n
layout (std430, binding = 6) writeonly buffer Out_logp { double logp_chain[]; }; // K

shared double partial[256];

void main() {
    uint i   = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationIndex;

    bool in_bounds = (i < pc.n);

    // Each thread carries its own dimension's running state.
    double qi = in_bounds ? q_init[i] : 0.0LF;
    double pi = in_bounds ? p_init[i] : 0.0LF;
    double mi = in_bounds ? inv_mass[i] : 0.0LF;

    for (uint k = 0; k < pc.K; k++) {
        // Half-step momentum at q
        // grad = 1 - lambda * exp(q_uc)
        double grad_q = in_bounds ? 1.0LF - pc.lambda * double(exp(float(qi))) : 0.0LF;
        double p_half = pi + 0.5LF * pc.eps * grad_q;

        // Full-step position
        qi = qi + pc.eps * mi * p_half;

        // Half-step momentum at q_new
        double grad_qn = in_bounds ? 1.0LF - pc.lambda * double(exp(float(qi))) : 0.0LF;
        pi = p_half + 0.5LF * pc.eps * grad_qn;

        // Write per-dimension chains
        if (in_bounds) {
            q_chain[k * pc.n + i]    = qi;
            p_chain[k * pc.n + i]    = pi;
            grad_chain[k * pc.n + i] = grad_qn;
        }

        // Per-step logp = sum_i (q_uc_i - lambda * exp(q_uc_i))
        // Reduce across workgroup.
        double lp_i = in_bounds ? qi - pc.lambda * double(exp(float(qi))) : 0.0LF;
        partial[tid] = lp_i;
        barrier();

        for (uint s = 128u; s > 0u; s /= 2u) {
            if (tid < s) partial[tid] += partial[tid + s];
            barrier();
        }

        if (tid == 0u) {
            logp_chain[k] = partial[0];
        }

        barrier();
    }
}
