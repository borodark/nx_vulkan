#version 450

// all / any over an axis — f32 input, PACKED u8 output. Collapses the
// middle `reduce_size` axis of an (outer, reduce_size, inner) view, and shares
// reduce_axis_*.comp's bindings and push layout, so it reuses `reduce_axis/7`
// with no new NIF.
//
// push `op`: 0 = all (every element truthy), 1 = any (at least one).
//
// TWO THINGS DIFFER from the reduce shaders it borrows from.
//
// The OUTPUT IS u8, not the input type. Nx types `all`/`any` as {:u, 8}
// whatever went in, so this writes packed u32 words — 4 results per word — and
// the caller pads the output buffer to a 4-byte multiple.
//
// ONE THREAD PER OUTPUT SLOT, and the packing is done with `atomicOr` rather
// than by giving each thread four slots. The first version did the latter, on
// the theory that the wasted threads were cheap. They were not: raced against
// `sum` and `argmax` on the identical shape (512x512, axis 1, s32, mac-248),
// this shader took 12.54 ms against their 3.94 and 3.97 — 3.2x slower for the
// same 262144 elements read. Four slots per thread means 4x the serial work AND
// a quarter of the parallelism, and both hurt.
//
// `atomicOr` is core GLSL 4.30 and needs no extension. The output buffer
// arrives ZEROED from `buf_alloc`, so a false result writes nothing and only
// the true bits need setting — no clearing pass, and the four threads sharing a
// word contend only when they are actually true.
//
// Truthiness is `!= 0`, which is what Nx means by it. Note that NaN is
// therefore TRUTHY — `NaN != 0.0` is true in IEEE and BinaryBackend agrees, so
// this needs no special case, unlike argreduce_*.comp where NaN had to be
// handled explicitly.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) buffer O { uint o[]; };

layout(push_constant) uniform Push {
    uint outer;
    uint reduce_size;
    uint inner;
    uint op;
} p;

bool truthy(uint i) {
    return a[i] != 0.0;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint slots = p.outer * p.inner;
    if (gid >= slots) return;

    bool is_any = (p.op == 1u);

    uint outr = gid / p.inner;
    uint inr = gid % p.inner;
    uint base = outr * p.reduce_size * p.inner + inr;

    // `all` starts true and is cleared by a falsy element; `any` starts false
    // and is set by a truthy one. An empty reduce keeps the seed, which is the
    // standard identity for both.
    bool acc = !is_any;
    for (uint r = 0u; r < p.reduce_size; ++r) {
        bool v = truthy(base + r * p.inner);
        acc = is_any ? (acc || v) : (acc && v);
    }

    // Zeroed buffer, so only a true result has anything to write.
    if (acc) {
        atomicOr(o[gid >> 2u], 1u << ((gid & 3u) * 8u));
    }
}
