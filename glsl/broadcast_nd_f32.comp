#version 450

// Explicit Nx.broadcast/3 for rank <= 4, f32.
//
// Implicit broadcasting inside a binary op already runs on the GPU
// (elementwise_binary_bcast_*.comp does this same index arithmetic), but the
// standalone broadcast callback had no shader at all and always went to the
// host. That mattered more than its own cost: it left the result on
// Nx.BinaryBackend, and a relu gradient's broadcast-of-zero then made select/4
// fall back too.
//
// Semantics match `Nx.broadcast(t, shape, axes: axes)`: input axis i lands on
// output axis axes[i], and any input axis of size 1 repeats along its output
// axis. A rank-0 input (in_rank = 0) fills the output with a[0].
//
// Params buffer: [out_rank, in_rank, out[4], in[4], axes[4]] — shapes
// left-aligned and padded to 4. One thread per output element.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer A { float a[]; };
layout(std430, binding = 1) writeonly buffer O { float o[]; };
layout(std430, binding = 2) readonly  buffer P { int prm[]; };

layout(push_constant) uniform Push {
    uint n;
} p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= p.n) return;

    uint out_rank = uint(prm[0]);
    uint in_rank  = uint(prm[1]);

    uint outs[4];
    uint ins[4];
    uint axes[4];
    for (uint i = 0u; i < 4u; ++i) {
        outs[i] = uint(prm[2 + i]);
        ins[i]  = uint(prm[6 + i]);
        axes[i] = uint(prm[10 + i]);
    }

    // Output coordinates.
    uint coord[4];
    uint idx = gid;
    for (int d = int(out_rank) - 1; d >= 0; --d) {
        coord[d] = idx % outs[d];
        idx = idx / outs[d];
    }

    // Row-major strides of the input.
    uint istride[4];
    uint s = 1u;
    for (int i = int(in_rank) - 1; i >= 0; --i) {
        istride[i] = s;
        s *= ins[i];
    }

    // Each input axis reads its mapped output coordinate, or 0 where it
    // broadcasts (size 1).
    uint in_off = 0u;
    for (uint i = 0u; i < in_rank; ++i) {
        uint c = coord[axes[i]];
        uint src = (ins[i] == 1u) ? 0u : c;
        in_off += src * istride[i];
    }

    o[gid] = a[in_off];
}
