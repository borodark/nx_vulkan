#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

// f64 sibling of leapfrog_chain_weibull.comp. All buffers and
// arithmetic in f64. Output sizes double (8 bytes per element).
//
// Fused chain of K NUTS leapfrog steps for a Weibull(k, lambda)
// log-density model on the unconstrained line (log-transform).
//
// Unconstrained: q_uc = log(q), q ~ Weibull(k, lambda).
// Log-density (with Jacobian):
//   log p(q_uc | k, lambda) = log(k) - k*log(lambda) + k*q_uc - (exp(q_uc)/lambda)^k
// Gradient:
//   grad = k * (1 - (exp(q_uc)/lambda)^k)
//
// Push constants: {n, K, eps, k, lambda, logp_const} = 4 + 4 + 8 + 8 + 8 + 8 = 40 bytes.
//   logp_const = n * (log(k) - k * log(lambda))  (precomputed on host)
// Single workgroup; n <= 256.

layout (local_size_x = 256) in;

layout (push_constant) uniform Push {
    uint   n;
    uint   K;
    double eps;
    double k;            // Weibull shape parameter
    double lambda;       // Weibull scale parameter
    double logp_const;   // n * (log(k) - k * log(lambda))
} pc;

layout (std430, binding = 0) readonly  buffer In_q     { double q_init[]; };
layout (std430, binding = 1) readonly  buffer In_p     { double p_init[]; };
layout (std430, binding = 2) readonly  buffer In_mass  { double inv_mass[]; };
layout (std430, binding = 3) writeonly buffer Out_q    { double q_chain[]; };    // K × n
layout (std430, binding = 4) writeonly buffer Out_p    { double p_chain[]; };    // K × n
layout (std430, binding = 5) writeonly buffer Out_grad { double grad_chain[]; }; // K × n
layout (std430, binding = 6) writeonly buffer Out_logp { double logp_chain[]; }; // K

shared double partial[256];

double weibull_grad(double q_uc) {
    double ratio = double(exp(float(q_uc))) / pc.lambda;
    return pc.k * (1.0LF - double(pow(float(ratio), float(pc.k))));
}

double weibull_logp_contrib(double q_uc) {
    double ratio = double(exp(float(q_uc))) / pc.lambda;
    return pc.k * q_uc - double(pow(float(ratio), float(pc.k)));
}

void main() {
    uint i   = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationIndex;
    bool in_bounds = (i < pc.n);

    double qi = in_bounds ? q_init[i] : 0.0LF;
    double pi = in_bounds ? p_init[i] : 0.0LF;
    double mi = in_bounds ? inv_mass[i] : 0.0LF;

    for (uint k = 0; k < pc.K; k++) {
        double grad_q = in_bounds ? weibull_grad(qi) : 0.0LF;
        double p_half = pi + 0.5LF * pc.eps * grad_q;
        qi = qi + pc.eps * mi * p_half;
        double grad_qn = in_bounds ? weibull_grad(qi) : 0.0LF;
        pi = p_half + 0.5LF * pc.eps * grad_qn;

        if (in_bounds) {
            q_chain[k * pc.n + i]    = qi;
            p_chain[k * pc.n + i]    = pi;
            grad_chain[k * pc.n + i] = grad_qn;
        }

        partial[tid] = in_bounds ? weibull_logp_contrib(qi) : 0.0LF;
        barrier();
        for (uint s = 128u; s > 0u; s /= 2u) {
            if (tid < s) partial[tid] += partial[tid + s];
            barrier();
        }
        if (tid == 0u) {
            logp_chain[k] = partial[0] + pc.logp_const;
        }
        barrier();
    }
}
