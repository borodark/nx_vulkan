#version 450

// s32 elementwise binary op. Spec constant 0 selects the op, sharing the float
// shaders' codes so `@binary_ops` needs no per-dtype table:
//   0=add 1=mul 2=sub 3=div 4=pow 5=max 6=min
// and adding the integer-only codes, which no float shader has:
//   7=quotient 8=remainder 9=bitwise_and 10=bitwise_or 11=bitwise_xor
//   12=left_shift 13=right_shift
//
// Code 3 is UNREACHABLE here and is left out deliberately rather than guessed
// at: `Nx.divide` on two integers returns {:f, 32}, so an integer divide never
// reaches this shader. Falling into `default` is the honest answer — a wrong
// one would be silent. Code 4 (pow) DOES arrive, but only with a non-negative
// exponent; see `ipow` below.
//
// Wrapping is the contract. Nx.BinaryBackend computes s32 arithmetic modulo
// 2^32 (2e9 + 2e9 -> -294967296), and GLSL signed int overflow wraps the same
// way, so `x + y` matches bit-for-bit with no widening. This is the OPPOSITE of
// reduce_axis_f32.comp, which accumulates in double precisely BECAUSE
// BinaryBackend sums floats in f64 — same principle, opposite conclusion.

layout(local_size_x = 256) in;
layout(constant_id = 0) const int OP = 0;

layout(std430, binding = 0) readonly buffer A { int a[]; };
layout(std430, binding = 1) readonly buffer B { int b[]; };
layout(std430, binding = 2) writeonly buffer O { int o[]; };

layout(push_constant) uniform Push { uint n; } p;

// Truncating division, and the remainder that pairs with it.
//
// GLSL leaves `/` and `%` UNDEFINED when either operand is negative, so neither
// can be used directly. Nx.BinaryBackend truncates toward zero
// (-7 quotient 3 = -2) and takes the sign of the DIVIDEND for the remainder
// (-7 rem 3 = -1, 7 rem -3 = 1). Computing the magnitudes unsigned and
// reapplying the sign gives exactly that, and `remainder = x - quotient*y`
// follows from it.
//
// Division by zero is left to the hardware rather than branched on: Nx's own
// doctests never divide by zero, and BinaryBackend raises rather than returning
// a value, so there is no defined result to match.
int trunc_div(int x, int y) {
    uint ux = uint(abs(x));
    uint uy = uint(abs(y));
    int q = int(ux / uy);
    return ((x < 0) != (y < 0)) ? -q : q;
}

// Integer exponentiation by squaring. The gate guarantees `e >= 0`, and that
// guarantee is not free — see the comment on `pow_exponent_nonneg?/1` in
// vulkano_backend.ex. Nx.BinaryBackend raises `ArithmeticError` on a negative
// integer exponent, and a shader cannot raise, so admitting one here would
// trade a correct error for a plausible number.
//
// Wrapping is the contract, same as everywhere else in this file:
// BinaryBackend gives pow(2, 32) = 0 and pow(3, 20) = -808182895, both modulo
// 2^32, and `int` multiplication wraps identically. A wider accumulator would
// produce the mathematically nicer answers and the wrong ones.
//
// At most 31 iterations: `n` is shifted right each pass.
int ipow(int base, int e) {
    int r = 1;
    int bb = base;
    uint n = uint(e);
    while (n != 0u) {
        if ((n & 1u) != 0u) r *= bb;
        bb *= bb;
        n >>= 1u;
    }
    return r;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;

    int x = a[i];
    int y = b[i];
    int r;
    switch (OP) {
        case 0:  r = x + y; break;
        case 1:  r = x * y; break;
        case 2:  r = x - y; break;
        case 4:  r = ipow(x, y); break;
        case 5:  r = max(x, y); break;
        case 6:  r = min(x, y); break;
        case 7:  r = trunc_div(x, y); break;
        case 8:  r = x - trunc_div(x, y) * y; break;
        case 9:  r = x & y; break;
        case 10: r = x | y; break;
        case 11: r = x ^ y; break;
        // Shifts: BinaryBackend shifts by the value, and a shift count at or
        // past the word width is undefined in GLSL, so clamp. `>>` on a signed
        // int is an ARITHMETIC shift in GLSL, which is what BinaryBackend does
        // for signed types (-8 >> 1 = -4).
        case 12: r = (y >= 32) ? 0 : x << y; break;
        case 13: r = (y >= 32) ? ((x < 0) ? -1 : 0) : x >> y; break;
        default: r = 0;
    }
    o[i] = r;
}
