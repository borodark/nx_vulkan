#version 450
#extension GL_ARB_gpu_shader_fp64 : require

// 2-D transpose for f64 tensors. Input A is m x n row-major; output O is
// n x m row-major with O[j, i] = A[i, j]. The f64-first backend must NOT use
// the legacy f32 `transpose.spv` here: that shader strides the buffer as
// 4-byte floats and corrupts every 8-byte double. Dispatch matches the
// transpose_2d NIF: global x over columns (n), global y over rows (m).

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer A { double a[]; };
layout(std430, binding = 1) writeonly buffer O { double o[]; };

layout(push_constant) uniform Push {
    uint m;   // rows of input
    uint n;   // cols of input
} p;

void main() {
    uint j = gl_GlobalInvocationID.x;   // input column, 0..n
    uint i = gl_GlobalInvocationID.y;   // input row,    0..m
    if (i >= p.m || j >= p.n) return;

    o[j * p.m + i] = a[i * p.n + j];
}
