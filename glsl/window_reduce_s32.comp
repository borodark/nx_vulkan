#version 450

// Windowed reduction for rank <= 4, s32. Spec constant 0 selects:
//   0=max 1=min 2=sum 3=product
//
// The accumulator is `int` and WRAPS, unlike the f32 twin's `double`. Same
// reason as reduce_axis_s32.comp: BinaryBackend computes s32 modulo 2^32, so
// window_sum([2e9, 2e9]) over a width-2 window is -294967296. Widening the
// accumulator would give the mathematically nicer answer and the wrong one.
//
// Type-preserving, s32 -> s32. Note that `window_sum` does NOT widen narrow
// integers the way `sum` does — Nx keeps {:s, 8} window_sum at {:s, 8} while
// widening {:s, 8} sum to {:s, 32}. Per-op rule, not per-dtype.
//
// This is pooling's forward pass. It was a host fallback, which cost more than
// its own time: it left the result on Nx.BinaryBackend, so the rest of the
// pooling chain ran there too, invisible to the fallback counter until the ops
// around it were fixed.
//
// One thread per OUTPUT element. Each walks its own window, so windows may
// overlap freely — no atomics, no coordination.
//
// The accumulator is seeded from the window's first element rather than an
// infinity literal, which keeps the shader identical in shape for f32 and f64
// and avoids depending on inf representation.
//
// Params buffer: [rank, in[4], out[4], win[4], strides[4], pad_lo[4], dil[4]] —
// shapes left-aligned, padded to 4 with 1s.
//
// PADDING AND DILATION ARE HANDLED HERE (W5). They used to be the gate: the
// backend refused any padded or dilated window and host-fell-back, which was 23
// doctests and — the part that mattered — not a dtype problem at all, since the
// f32 cases were refused identically.
//
// The implementation needs no identity literals and no `inf`. Nx pads a window
// reduction with the OP'S IDENTITY (0 for sum, 1 for product, -inf for max,
// +inf for min), and for every one of those, SKIPPING the element is the same
// as combining with the identity — EXCEPT when the whole window is padding and
// there is nothing to seed from, which is handled explicitly at the end. So an
// out-of-bounds source index is simply
// not read: sum skips an implicit 0, product an implicit 1, and max/min ignore
// it, which is what -inf/+inf would have done. That keeps this shader free of
// the inf representation dependency the original deliberately avoided, and it
// makes the integer twin identical in shape rather than needing INT_MIN/MAX.
//
// `seen` exists because max/min can no longer seed from element 0 — with a
// leading pad, element 0 is not in the tensor.

layout(local_size_x = 256) in;
layout(constant_id = 0) const int OP = 0;

layout(std430, binding = 0) readonly  buffer A { int a[]; };
layout(std430, binding = 1) writeonly buffer O { int o[]; };
layout(std430, binding = 2) readonly  buffer P { int prm[]; };

layout(push_constant) uniform Push {
    uint n;
    uint rank;
} p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= p.n) return;

    uint ins[4];
    uint outs[4];
    uint win[4];
    uint str[4];
    int lo[4];
    uint dil[4];
    for (uint i = 0u; i < 4u; ++i) {
        ins[i]  = uint(prm[1 + i]);
        outs[i] = uint(prm[5 + i]);
        win[i]  = uint(prm[9 + i]);
        str[i]  = uint(prm[13 + i]);
        lo[i]   = prm[17 + i];
        dil[i]  = uint(prm[21 + i]);
    }

    // Output coordinates -> the window's origin in the input.
    uint oc[4];
    uint idx = gid;
    for (int d = int(p.rank) - 1; d >= 0; --d) {
        oc[d] = idx % outs[d];
        idx = idx / outs[d];
    }

    uint istride[4];
    uint s = 1u;
    for (int d = int(p.rank) - 1; d >= 0; --d) {
        istride[d] = s;
        s *= ins[d];
    }

    uint total = 1u;
    for (uint d = 0u; d < p.rank; ++d) total *= win[d];

    int best = 0;
    bool seen = false;
    int acc = (OP == 3) ? 1 : 0;
    for (uint w = 0u; w < total; ++w) {
        uint rem = w;
        int in_off = 0;
        bool inside = true;
        for (int d = int(p.rank) - 1; d >= 0; --d) {
            uint wc = rem % win[d];
            rem = rem / win[d];
            int src = int(oc[d] * str[d] + wc * dil[d]) - lo[d];
            if (src < 0 || src >= int(ins[d])) inside = false;
            in_off += src * int(istride[d]);
        }

        // Out of bounds means "this element is padding". Skipping it IS
        // combining with the identity — see the note at the top.
        if (!inside) continue;

        int v = a[in_off];
        if (OP == 2) {
            acc += v;
        } else if (OP == 3) {
            acc *= v;
        } else if (!seen) {
            best = v;
            seen = true;
        } else {
            best = (OP == 0) ? max(best, v) : min(best, v);
        }
    }

    if (OP >= 2) {
        o[gid] = acc;
    } else if (seen) {
        o[gid] = best;
    } else {
        // EVERY element of this window was padding, so there is nothing to
        // combine with and the "skipping is combining with the identity" trick
        // above has no seed to work from. BinaryBackend returns the identity
        // itself here — -inf/+inf for floats, INT_MIN/INT_MAX for s32 — and
        // this is the one place the shader has to name it.
        //
        // Reachable whenever a pad is at least as wide as the window, e.g.
        // window_max(t, {2}, padding: [{2, 2}]). Found by differential test,
        // not by reading: the value assertions all passed without it, because
        // every window they used touched at least one real element.
        o[gid] = (OP == 0) ? (-2147483647 - 1) : 2147483647;
    }
}
