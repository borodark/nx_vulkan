#version 450

// Windowed reduction for rank <= 4, s32. Spec constant 0 selects:
//   0=max 1=min 2=sum 3=product
//
// The accumulator is `int` and WRAPS, unlike the f32 twin's `double`. Same
// reason as reduce_axis_s32.comp: BinaryBackend computes s32 modulo 2^32, so
// window_sum([2e9, 2e9]) over a width-2 window is -294967296. Widening the
// accumulator would give the mathematically nicer answer and the wrong one.
//
// Type-preserving, s32 -> s32. Note that `window_sum` does NOT widen narrow
// integers the way `sum` does — Nx keeps {:s, 8} window_sum at {:s, 8} while
// widening {:s, 8} sum to {:s, 32}. Per-op rule, not per-dtype.
//
// This is pooling's forward pass. It was a host fallback, which cost more than
// its own time: it left the result on Nx.BinaryBackend, so the rest of the
// pooling chain ran there too, invisible to the fallback counter until the ops
// around it were fixed.
//
// One thread per OUTPUT element. Each walks its own window, so windows may
// overlap freely — no atomics, no coordination.
//
// The accumulator is seeded from the window's first element rather than an
// infinity literal, which keeps the shader identical in shape for f32 and f64
// and avoids depending on inf representation.
//
// Params buffer: [rank, in[4], out[4], win[4], strides[4]] — shapes
// left-aligned, padded to 4 with 1s. Padding and window dilation are NOT
// handled here; the backend only dispatches this for the unpadded, undilated
// case and host-falls-back otherwise.

layout(local_size_x = 256) in;
layout(constant_id = 0) const int OP = 0;

layout(std430, binding = 0) readonly  buffer A { int a[]; };
layout(std430, binding = 1) writeonly buffer O { int o[]; };
layout(std430, binding = 2) readonly  buffer P { int prm[]; };

layout(push_constant) uniform Push {
    uint n;
    uint rank;
} p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= p.n) return;

    uint ins[4];
    uint outs[4];
    uint win[4];
    uint str[4];
    for (uint i = 0u; i < 4u; ++i) {
        ins[i]  = uint(prm[1 + i]);
        outs[i] = uint(prm[5 + i]);
        win[i]  = uint(prm[9 + i]);
        str[i]  = uint(prm[13 + i]);
    }

    // Output coordinates -> the window's origin in the input.
    uint oc[4];
    uint idx = gid;
    for (int d = int(p.rank) - 1; d >= 0; --d) {
        oc[d] = idx % outs[d];
        idx = idx / outs[d];
    }

    uint istride[4];
    uint s = 1u;
    for (int d = int(p.rank) - 1; d >= 0; --d) {
        istride[d] = s;
        s *= ins[d];
    }

    uint total = 1u;
    for (uint d = 0u; d < p.rank; ++d) total *= win[d];

    int best = 0;
    int acc = (OP == 3) ? 1 : 0;
    for (uint w = 0u; w < total; ++w) {
        uint rem = w;
        uint in_off = 0u;
        for (int d = int(p.rank) - 1; d >= 0; --d) {
            uint wc = rem % win[d];
            rem = rem / win[d];
            in_off += (oc[d] * str[d] + wc) * istride[d];
        }

        int v = a[in_off];
        if (OP == 2) {
            acc += v;
        } else if (OP == 3) {
            acc *= v;
        } else if (w == 0u) {
            best = v;
        } else {
            best = (OP == 0) ? max(best, v) : min(best, v);
        }
    }

    o[gid] = (OP >= 2) ? acc : best;
}
