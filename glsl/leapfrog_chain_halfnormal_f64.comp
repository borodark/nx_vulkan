#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

// f64 sibling of leapfrog_chain_halfnormal.comp. All buffers and
// arithmetic in f64. Output sizes double (8 bytes per element).
//
// Fused chain of K NUTS leapfrog steps for HalfNormal(sigma).
// Positive-valued via log-transform: q_uc = log(q).
//
// Unconstrained log-density (with Jacobian):
//   log p(q_uc | sigma) = q_uc - 0.5 * exp(2*q_uc) / sigma^2 + const
// Gradient:
//   grad = 1 - exp(2*q_uc) / sigma^2
//
// Push constants: {n, K, eps, sigma, log_const} = 4 + 4 + 8 + 8 + 8 = 32 bytes.
//   log_const = -log(sigma) - 0.5*log(pi)  (precomputed on host)
// Single workgroup; n <= 256.
//
// Numerical note: exp(2*q_uc) overflows for q_uc > ~709 (f64).
// For typical priors with sigma ~ 1, this is not reachable.

layout (local_size_x = 256) in;

layout (push_constant) uniform Push {
    uint   n;
    uint   K;
    double eps;
    double sigma;
    double log_const;   // -log(sigma) - 0.5*log(pi)
} pc;

layout (std430, binding = 0) readonly  buffer In_q     { double q_init[]; };
layout (std430, binding = 1) readonly  buffer In_p     { double p_init[]; };
layout (std430, binding = 2) readonly  buffer In_mass  { double inv_mass[]; };
layout (std430, binding = 3) writeonly buffer Out_q    { double q_chain[]; };    // K × n
layout (std430, binding = 4) writeonly buffer Out_p    { double p_chain[]; };    // K × n
layout (std430, binding = 5) writeonly buffer Out_grad { double grad_chain[]; }; // K × n
layout (std430, binding = 6) writeonly buffer Out_logp { double logp_chain[]; }; // K

shared double partial[256];

void main() {
    uint i   = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationIndex;

    bool in_bounds = (i < pc.n);
    double inv_sigma2 = 1.0LF / (pc.sigma * pc.sigma);

    double qi = in_bounds ? q_init[i] : 0.0LF;
    double pi = in_bounds ? p_init[i] : 0.0LF;
    double mi = in_bounds ? inv_mass[i] : 0.0LF;

    for (uint k = 0; k < pc.K; k++) {
        // Half-step momentum at q
        double exp_2q = double(exp(float(2.0LF * qi)));
        double grad_q = in_bounds ? 1.0LF - exp_2q * inv_sigma2 : 0.0LF;
        double p_half = pi + 0.5LF * pc.eps * grad_q;

        // Full-step position
        qi = qi + pc.eps * mi * p_half;

        // Half-step momentum at q_new
        double exp_2qn = double(exp(float(2.0LF * qi)));
        double grad_qn = in_bounds ? 1.0LF - exp_2qn * inv_sigma2 : 0.0LF;
        pi = p_half + 0.5LF * pc.eps * grad_qn;

        if (in_bounds) {
            q_chain[k * pc.n + i]    = qi;
            p_chain[k * pc.n + i]    = pi;
            grad_chain[k * pc.n + i] = grad_qn;
        }

        // Per-step logp: sum_i (q_uc - 0.5*exp(2*q_uc)/sigma^2) + n*log_const
        double lp_i = in_bounds ? qi - 0.5LF * exp_2qn * inv_sigma2 : 0.0LF;
        partial[tid] = lp_i;
        barrier();

        for (uint s = 128u; s > 0u; s /= 2u) {
            if (tid < s) partial[tid] += partial[tid + s];
            barrier();
        }

        if (tid == 0u) {
            logp_chain[k] = partial[0] + double(pc.n) * pc.log_const;
        }

        barrier();
    }
}
