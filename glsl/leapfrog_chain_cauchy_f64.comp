#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

// f64 sibling of leapfrog_chain_cauchy.comp. All buffers and
// arithmetic in f64. Output sizes double (8 bytes per element).
//
// Fused chain of K NUTS leapfrog steps for Cauchy(loc, scale).
// Real-valued — no transform needed. Special case of Student-t at nu=1.
//
// log p(q | loc, scale) = -log(pi*scale) - log(1 + ((q-loc)/scale)^2)
// Gradient: -2*(q-loc) / (scale^2 + (q-loc)^2)
//
// Push constants: {n, K, eps, loc, scale, log_pi_scale} = 4 + 4 + 8 + 8 + 8 + 8 = 40 bytes.
// Single workgroup; n <= 256.

layout (local_size_x = 256) in;

layout (push_constant) uniform Push {
    uint   n;
    uint   K;
    double eps;
    double loc;
    double scale;
    double log_pi_scale;   // -log(pi * scale), precomputed on host
} pc;

layout (std430, binding = 0) readonly  buffer In_q     { double q_init[]; };
layout (std430, binding = 1) readonly  buffer In_p     { double p_init[]; };
layout (std430, binding = 2) readonly  buffer In_mass  { double inv_mass[]; };
layout (std430, binding = 3) writeonly buffer Out_q    { double q_chain[]; };    // K × n
layout (std430, binding = 4) writeonly buffer Out_p    { double p_chain[]; };    // K × n
layout (std430, binding = 5) writeonly buffer Out_grad { double grad_chain[]; }; // K × n
layout (std430, binding = 6) writeonly buffer Out_logp { double logp_chain[]; }; // K

shared double partial[256];

void main() {
    uint i   = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationIndex;

    bool in_bounds = (i < pc.n);
    double scale2 = pc.scale * pc.scale;

    double qi = in_bounds ? q_init[i] : 0.0LF;
    double pi = in_bounds ? p_init[i] : 0.0LF;
    double mi = in_bounds ? inv_mass[i] : 0.0LF;

    for (uint k = 0; k < pc.K; k++) {
        // Half-step momentum at q
        double diff = qi - pc.loc;
        double grad_q = in_bounds ? -2.0LF * diff / (scale2 + diff * diff) : 0.0LF;
        double p_half = pi + 0.5LF * pc.eps * grad_q;

        // Full-step position
        qi = qi + pc.eps * mi * p_half;

        // Half-step momentum at q_new
        double diff_n = qi - pc.loc;
        double grad_qn = in_bounds ? -2.0LF * diff_n / (scale2 + diff_n * diff_n) : 0.0LF;
        pi = p_half + 0.5LF * pc.eps * grad_qn;

        if (in_bounds) {
            q_chain[k * pc.n + i]    = qi;
            p_chain[k * pc.n + i]    = pi;
            grad_chain[k * pc.n + i] = grad_qn;
        }

        // Per-step logp: sum_i -log(1 + (diff/scale)^2) + n * log_pi_scale
        double z = diff_n / pc.scale;
        double lp_i = in_bounds ? -double(log(float(1.0LF + z * z))) : 0.0LF;
        partial[tid] = lp_i;
        barrier();

        for (uint s = 128u; s > 0u; s /= 2u) {
            if (tid < s) partial[tid] += partial[tid + s];
            barrier();
        }

        if (tid == 0u) {
            logp_chain[k] = partial[0] + double(pc.n) * pc.log_pi_scale;
        }

        barrier();
    }
}
