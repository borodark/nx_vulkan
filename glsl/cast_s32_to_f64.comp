#version 450
#extension GL_ARB_gpu_shader_fp64 : require
// Widen s32 -> f64 on the GPU. n = element count. See cast_s32_to_f32.comp for
// why an integer cast path is needed at all.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer In { int inp[]; };
layout(std430, binding = 1) writeonly buffer Out { double outp[]; };
layout(push_constant) uniform Push { uint n; } p;
void main() { uint i = gl_GlobalInvocationID.x; if (i >= p.n) return; outp[i] = double(inp[i]); }
