#version 450

// f32 matmul with a naive f32 accumulator — the baseline that motivates the
// f64-accumulator variant. Kept ONLY for the accuracy experiment
// (examples/f32_accumulator.exs); the backend dispatches the f64-accumulator
// shader. As K grows the f32 accumulator loses precision (catastrophic
// cancellation), diverging from a f64-accumulating reference.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };

layout(push_constant) uniform Push {
    uint m;
    uint n;
    uint k;
} push;

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    if (row >= push.m || col >= push.n) return;

    float acc = 0.0;
    for (uint i = 0u; i < push.k; ++i) {
        acc += a[row * push.k + i] * b[i * push.n + col];
    }
    o[row * push.n + col] = acc;
}
