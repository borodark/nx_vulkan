#version 450
#extension GL_ARB_gpu_shader_fp64 : require

// Convolution GEMM: multiply the im2col matrix A (M x K) by the flattened
// kernel W (Cout x K) and write straight into the output's canonical layout
// {N, Cout, O_total}, so no post-transpose/permute is needed.
//
//   A row  = n*O_total + o          (from conv_im2col)
//   W row  = oc,  W[oc*K + l]        (kernel {Cout, Cin, K...} flattened)
//   out[((n*Cout + oc)*O_total) + o] = sum_l A[(n*O_total+o)*K + l] * W[oc*K + l]
//
// One invocation per output element; the linear id already equals the output
// flat index because it is decoded in (n, oc, o) order.

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer A { double a[]; };
layout(std430, binding = 1) readonly buffer W { double w[]; };
layout(std430, binding = 2) writeonly buffer Out { double outp[]; };

layout(push_constant) uniform Push {
    uint N;
    uint Cout;
    uint O_total;
    uint K;
} p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total = p.N * p.Cout * p.O_total;
    if (gid >= total) return;

    uint n = gid / (p.Cout * p.O_total);
    uint rem = gid % (p.Cout * p.O_total);
    uint oc = rem / p.O_total;
    uint o = rem % p.O_total;

    uint arow = n * p.O_total + o;
    uint abase = arow * p.K;
    uint wbase = oc * p.K;

    double acc = 0.0lf;
    for (uint l = 0u; l < p.K; ++l) {
        acc += a[abase + l] * w[wbase + l];
    }

    outp[gid] = acc;
}
